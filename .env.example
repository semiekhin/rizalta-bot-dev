# Fernet key для шифрования паролей риэлторов в rclick_tokens.db.
# КРИТИЧНО: не менять после первой установки — смена ключа делает все сохранённые пароли нечитаемыми.
# Генерация: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RCLICK_ENCRYPTION_KEY=
